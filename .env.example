# Vessel 环境变量配置
# 复制此文件为 .env 并填入你的实际值

# API Key（必填）
VESSEL_API_KEY=your-api-key-here

# Provider 配置（可选）
VESSEL_BASE_URL=https://api.openai.com/v1
VESSEL_MODEL=gpt-4

# Gateway / loopback token（可选；不要在这里写真实值）
# 用途：--serve 与 loopback transport 的共享 token
# 优先级：config > VESSEL_GATEWAY_TOKEN > gateway 自动生成
VESSEL_GATEWAY_TOKEN=

# 飞书（可选；不要在这里写真实值）
# 环境变量优先于 vessel.yaml 的 feishu.app_id / feishu.app_secret
VESSEL_FEISHU_APP_ID=
VESSEL_FEISHU_APP_SECRET=
