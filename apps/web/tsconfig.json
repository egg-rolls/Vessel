{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // 共享 UI 包按 workspace 源码消费，不经过 node_modules 复制。
    // 这里**不写 `baseUrl`**（TS 7 已删除该选项，写了会在 `apps/web` 被根 7.x 编到时报
    // TS5102）：没有 baseUrl 时 `paths` 以**本文件所在目录**为基准解析，与写 `"baseUrl": "."`
    // 完全等价 —— 下面的映射不需要改一个字符。
    "paths": {
      "@vessel-agent/plugin-ui": ["../../packages/plugin-ui/src/index.ts"],
      "@vessel-agent/plugin-ui/*": ["../../packages/plugin-ui/src/*"],
      "@vessel-agent/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      // q-addr-display：地址显示纯函数按源码消费（零 import leaf，不拖 agent 包依赖图；
      // 先例：plugin-ui / plugin-sdk）。只映射这一个子路径，包根不开放。
      "@vessel-agent/agent/address-display": ["../../packages/agent/src/address-display.ts"]
    },
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // 与根 tsconfig 对齐：web 是最大单一代码面（约 3.9 万行），
    // 越界下标 / 隐式返回 / 漏写 override 必须由编译器兜住，不能只靠人肉警戒线。
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "scripts"]
}
