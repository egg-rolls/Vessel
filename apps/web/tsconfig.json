{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // 共享 UI 包按 workspace 源码消费，不经过 node_modules 复制。
    "baseUrl": ".",
    "paths": {
      "@vessel-agent/plugin-ui": ["../../packages/plugin-ui/src/index.ts"],
      "@vessel-agent/plugin-ui/*": ["../../packages/plugin-ui/src/*"]
    },
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // 与根 tsconfig 对齐：web 是最大单一代码面（约 3.9 万行），
    // 越界下标 / 隐式返回 / 漏写 override 必须由编译器兜住，不能只靠人肉警戒线。
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
