# ============================================================
# Vessel — .gitignore
# ============================================================
# TypeScript + Bun monorepo，三层架构（core / config / tui）+ plugins/

# ----------------------------------------------------------
# 1. Dependencies
# ----------------------------------------------------------
node_modules/
.bun/
bun.lockb

# ----------------------------------------------------------
# 2. Build output
# ----------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
*.js.map
*.d.ts.map
*.cjs.map
*.mjs.map

# Bun compile output
vessel

# Release artifacts generated locally
latest.json
latest-beta.json
SHA256SUMS

# ----------------------------------------------------------
# 3. Runtime data (Vessel)
# ----------------------------------------------------------
.vessel/
*.db
*.sqlite
*.sqlite3

# ----------------------------------------------------------
# 4. Environment & Secrets
# ----------------------------------------------------------
.env
.env.*
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
# Self-signed localhost TLS fixtures are committed intentionally.
!packages/serve/__tests__/fixtures/tls/*.pem
secrets/
credentials.json
service-account.json
*.credentials.json

# ----------------------------------------------------------
# 5. Logs
# ----------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# ----------------------------------------------------------
# 6. Test & Coverage
# ----------------------------------------------------------
coverage/
.nyc_output/
.c8_output/
.lcov/
coverage.lcov
test-results/
reports/
# docs/dev/ 全部属个人侧（外层仓 D:/Application/APP/Vessel/docs/dev/），代码仓不跟踪
# （用户裁定：kanban/plans/reports/research/design/specs 等 dev 文档归个人侧，不上代码云）
docs/dev/
*.snap

# ----------------------------------------------------------
# 7. IDE / Editor
# ----------------------------------------------------------
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
\#*\#
.#*
.project
.classpath
.settings/
*.sublime-*
*.code-workspace
.history/

# ----------------------------------------------------------
# 8. OS
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------------------------------
# 9. Debug / Temp
# ----------------------------------------------------------
*.tmp
*.temp
*.bak
*.cache
*.out
.cache/
tmp/
temp/
*.dmp

# ----------------------------------------------------------
# 10. Archives
# ----------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ----------------------------------------------------------
# 11. Docker / Containers
# ----------------------------------------------------------
.docker/
docker-compose.override.yml

# ----------------------------------------------------------
# 12. Misc tooling
# ----------------------------------------------------------
.eslintcache
.parcel-cache/
.turbo/
.next/
.nuxt/
.sst/
.wrangler/
.codegraph/

# ----------------------------------------------------------
# 13. Temp text files (commit-message drafts, etc.)
# Repo docs use .md; .txt is only transient/local, never tracked.
# ----------------------------------------------------------
*.txt

# 配置键名误当重定向目标产生的空文件（历史上被误提交过，别再进库）
node.token*
node.tokens*
node.allowed_origins
serve.token*
serve.allowed_origins
