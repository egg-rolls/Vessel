{
  "name": "vessel-agent",
  "version": "0.14.1",
  "description": "Vessel — an embeddable, provider-agnostic multi-agent runtime and CLI harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vessel": "src/cli.ts"
  },
  "files": [
    "src",
    "packages",
    "plugins",
    "skills",
    "apps/web/dist",
    "README.md",
    "LICENSE",
    "!**/node_modules/**",
    "!**/__tests__",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/egg-rolls/Vessel.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "demo": "bun run examples/demo.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "lint": "bunx @biomejs/biome ci .",
    "typecheck": "tsc --noEmit && tsc -p examples --noEmit",
    "typecheck:examples": "tsc -p examples --noEmit",
    "format": "bunx @biomejs/biome format --write .",
    "check": "bunx @biomejs/biome check ."
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "dependencies": {
    "@promptctl/rich-js": "^0.10.0",
    "@vessel-agent/config": "0.14.1",
    "@vessel-agent/core": "0.14.1",
    "@vessel-agent/permission": "0.14.1",
    "@vessel-agent/serve": "0.14.1",
    "@vessel-agent/tui": "0.14.1",
    "yaml": "^2.9.0"
  }
}
