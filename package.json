{
  "name": "vessel",
  "version": "0.8.5",
  "description": "Vessel — an embeddable, provider-agnostic multi-agent runtime and CLI harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vessel": "src/cli.ts"
  },
  "files": [
    "src",
    "packages",
    "plugins",
    "skills",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "demo": "bun run examples/demo.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "lint": "bunx @biomejs/biome ci .",
    "typecheck": "tsc --noEmit && tsc -p examples --noEmit",
    "typecheck:examples": "tsc -p examples --noEmit",
    "format": "bunx @biomejs/biome format --write .",
    "check": "bunx @biomejs/biome check ."
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "dependencies": {
    "@promptctl/rich-js": "^0.6.0",
    "@vessel/config": "^0.8.5",
    "@vessel/core": "^0.8.5",
    "@vessel/permission": "^0.8.5",
    "@vessel/serve": "^0.8.5",
    "@vessel/tui": "^0.8.5",
    "yaml": "^2.9.0"
  }
}
