{
  "name": "vessel",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "private": true,
  "scripts": {
    "start": "bun run src/cli.ts",
    "demo": "bun run examples/demo.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "lint": "bunx @biomejs/biome ci .",
    "typecheck": "tsc --noEmit",
    "format": "bunx @biomejs/biome format --write .",
    "check": "bunx @biomejs/biome check ."
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "dependencies": {
    "@promptctl/rich-js": "^0.6.0",
    "yaml": "^2.9.0"
  }
}
