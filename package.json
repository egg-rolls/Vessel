{
  "name": "vessel-agent",
  "version": "0.52.0",
  "description": "Vessel — an embeddable, provider-agnostic multi-agent runtime and CLI harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vessel": "src/cli.ts"
  },
  "files": [
    "src",
    "packages",
    "plugins",
    "skills",
    "apps/web/dist",
    "README.md",
    "LICENSE",
    "!**/node_modules/**",
    "!**/__tests__",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/egg-rolls/Vessel.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "demo": "bun run examples/demo.ts",
    "dev:web": "bun run scripts/dev-web.ts",
    "build:web:watch": "bun run --cwd apps/web build:watch",
    "build": "bun run scripts/build.ts",
    "lint": "bunx @biomejs/biome ci .",
    "typecheck": "tsc --noEmit && tsc -p examples --noEmit",
    "typecheck:examples": "tsc -p examples --noEmit",
    "format": "bunx @biomejs/biome format --write .",
    "check": "bunx @biomejs/biome check .",
    "check:prompt-prefix": "bun run scripts/check-prompt-prefix.ts",
    "check:web-styles": "bun run scripts/check-web-styles.ts",
    "check:chat-visibility": "bun run scripts/check-chat-visibility.ts",
    "check:archived-visibility": "bun run scripts/check-archived-visibility.ts",
    "check:event-visibility": "bun run scripts/check-event-visibility.ts",
    "check:history-tools": "bun run scripts/check-history-tools.ts",
    "check:live-items": "bun run scripts/check-live-items.ts",
    "check:run-reconcile": "bun run scripts/check-run-reconcile.ts",
    "check:reconnect": "bun run scripts/check-reconnect.ts",
    "check:transcript-items": "bun run scripts/check-transcript-items.ts",
    "check:replay-budget": "bun run scripts/check-replay-budget.ts",
    "gates": "bunx @biomejs/biome ci . && bun run typecheck && bun run build && cd apps/web && bun run build && cd ../.. && bun run scripts/check-deps.ts && bun run scripts/check-docs.ts && bun run scripts/check-i18n.ts && bun run scripts/check-rpc-methods.ts && bun run scripts/smoke-subpaths.ts && bun run scripts/check-config-sources.ts && bun run scripts/check-trace.ts && bun run check:prompt-prefix && bun run check:web-styles && bun run check:chat-visibility && bun run check:event-visibility && bun run check:history-tools && bun run check:live-items && bun run check:transcript-items && bun run check:replay-budget && bun run check:listrich-cache && bun run check:plugin-ports && bun run check:ask-attribution && bun run check:append-only-context --phase=1 && bun run check:conflict-markers && bun run check:archived-visibility && bun run check:ask-drafts && bun run check:ask-dedupe && bun run check:context-anchor && bun run check:context-ratio && bun run check:agent-tool-list && bun run check:session-agent-label && bun run check:env-card-layout && bun run check:run-reconcile && bun run check:theme-apply && bun run check:ask-cursor && bun run check:session-agent-binding && bun run check:ask-selection && bun run check:lease-suspend && bun run check:prompt-context-dedup && bun run check:error-text && bun run check:node-handoff && bun run check:reconnect && bun run check:prompt-context-e2e && bun run check:node-drain && bun run check:rotate-accounting && bun run check:pii-guard && bun run check:web-fetch && bun run check:ask-groups && bun run check:inbox-unhold && bun run check:peer-notice && bun run check:env-scope-parity && bun run check:session-events && bun run check:tool-card-args && bun run check:request-append-only && bun run check:tool-result-clear && bun run check:compaction-segment",
    "check:listrich-cache": "bun run scripts/check-listrich-cache.ts",
    "check:conflict-markers": "bun run scripts/check-conflict-markers.ts",
    "check:plugin-ports": "bun run scripts/check-plugin-ports.ts",
    "check:ask-attribution": "bun run scripts/check-ask-attribution.ts",
    "check:append-only-context": "bun run scripts/check-append-only-context.ts",
    "check:pii-guard": "bun run scripts/check-pii-guard.ts",
    "check:pii-vault": "bun run scripts/check-pii-vault.ts",
    "check:context-anchor": "bun run scripts/check-context-anchor.ts",
    "check:ask-drafts": "bun run scripts/check-ask-drafts.ts",
    "check:ask-dedupe": "bun run scripts/check-ask-dedupe.ts",
    "check:context-ratio": "bun run scripts/check-context-ratio.ts",
    "check:agent-tool-list": "bun run scripts/check-agent-tool-list.ts",
    "check:session-agent-label": "bun run scripts/check-session-agent-label.ts",
    "check:env-card-layout": "bun run scripts/check-env-card-layout.ts",
    "check:theme-apply": "bun run scripts/check-theme-apply.ts",
    "check:ask-cursor": "bun run scripts/check-ask-cursor.ts",
    "check:session-agent-binding": "bun run scripts/check-session-agent-binding.ts",
    "check:ask-selection": "bun run scripts/check-ask-selection.ts",
    "check:ask-groups": "bun run scripts/check-ask-groups.ts",
    "check:inbox-unhold": "bun run scripts/check-inbox-unhold.ts",
    "check:peer-notice": "bun run scripts/check-peer-notice.ts",
    "check:env-scope-parity": "bun run scripts/check-env-scope-parity.ts",
    "check:session-events": "bun run scripts/check-session-events.ts",
    "check:tool-card-args": "bun run src/tool-card-args.test.ts",
    "check:lease-suspend": "bun run scripts/check-lease-suspend.ts",
    "check:prompt-context-dedup": "bun run scripts/check-prompt-context-dedup.ts",
    "check:prompt-context-e2e": "bun run scripts/check-prompt-context-e2e.ts",
    "check:error-text": "bun run scripts/check-error-text.ts",
    "check:node-handoff": "bun run scripts/check-node-handoff.ts",
    "check:node-drain": "bun run scripts/check-node-drain.ts",
    "check:resume-boot": "bun run scripts/check-resume-boot.ts",
    "check:rotate-accounting": "bun run scripts/check-rotate-accounting.ts",
    "check:web-fetch": "bun run scripts/check-web-fetch.ts",
    "check:request-append-only": "bun run scripts/check-request-append-only.ts",
    "check:tool-result-clear": "bun run scripts/check-tool-result-clear.ts",
    "check:compaction-segment": "bun run scripts/check-compaction-segment.ts"
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "dependencies": {
    "@promptctl/rich-js": "^0.10.0",
    "@vessel-agent/agent": "0.52.0",
    "@vessel-agent/config": "0.52.0",
    "@vessel-agent/core": "0.52.0",
    "@vessel-agent/permission": "0.52.0",
    "@vessel-agent/serve": "0.52.0",
    "@vessel-agent/tui": "0.52.0",
    "yaml": "^2.9.0"
  }
}
