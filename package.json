{
  "name": "vessel-agent",
  "version": "0.50.0",
  "description": "Vessel — an embeddable, provider-agnostic multi-agent runtime and CLI harness",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vessel": "src/cli.ts"
  },
  "files": [
    "src",
    "packages",
    "plugins",
    "skills",
    "apps/web/dist",
    "README.md",
    "LICENSE",
    "!**/node_modules/**",
    "!**/__tests__",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/egg-rolls/Vessel.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "demo": "bun run examples/demo.ts",
    "dev:web": "bun run scripts/dev-web.ts",
    "build:web:watch": "bun run --cwd apps/web build:watch",
    "build": "bun run scripts/build.ts",
    "lint": "bunx @biomejs/biome ci .",
    "typecheck": "tsc --noEmit && tsc -p examples --noEmit",
    "typecheck:examples": "tsc -p examples --noEmit",
    "format": "bunx @biomejs/biome format --write .",
    "check": "bunx @biomejs/biome check .",
    "check:prompt-prefix": "bun run scripts/check-prompt-prefix.ts",
    "check:web-styles": "bun run scripts/check-web-styles.ts",
    "check:chat-visibility": "bun run scripts/check-chat-visibility.ts",
    "check:event-visibility": "bun run scripts/check-event-visibility.ts",
    "check:history-tools": "bun run scripts/check-history-tools.ts",
    "check:live-items": "bun run scripts/check-live-items.ts",
    "check:transcript-items": "bun run scripts/check-transcript-items.ts",
    "check:replay-budget": "bun run scripts/check-replay-budget.ts",
    "gates": "bunx @biomejs/biome ci . && bun run typecheck && bun run build && cd apps/web && bun run build && bun run scripts/check-deps.ts && bun run scripts/check-docs.ts && bun run scripts/check-i18n.ts && bun run scripts/check-rpc-methods.ts && bun run scripts/smoke-subpaths.ts && bun run scripts/check-config-sources.ts && bun run scripts/check-trace.ts && bun run check:prompt-prefix && bun run check:web-styles && bun run check:chat-visibility && bun run check:event-visibility && bun run check:history-tools && bun run check:live-items && bun run check:transcript-items && bun run check:replay-budget && bun run check:listrich-cache",
    "check:listrich-cache": "bun run scripts/check-listrich-cache.ts"
  },
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "dependencies": {
    "@promptctl/rich-js": "^0.10.0",
    "@vessel-agent/agent": "0.50.0",
    "@vessel-agent/config": "0.50.0",
    "@vessel-agent/core": "0.50.0",
    "@vessel-agent/permission": "0.50.0",
    "@vessel-agent/serve": "0.50.0",
    "@vessel-agent/tui": "0.50.0",
    "yaml": "^2.9.0"
  }
}
