{
  "name": "@vessel-agent/plugin-usage",
  "version": "0.50.0",
  "description": "Usage, logs and model leaderboard for Vessel",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/egg-rolls/Vessel.git",
    "directory": "plugins/observability/usage"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "build:ui": "tsc -p tsconfig.web.json --noEmit && vite build",
    "typecheck:ui": "tsc -p tsconfig.web.json --noEmit",
    "probe": "bun run test/probe.ts"
  },
  "dependencies": {
    "@vessel-agent/core": "0.50.0",
    "@vessel-agent/plugin-ui": "0.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0"
  },
  "vessel": {
    "id": "usage",
    "name": "Usage",
    "version": "0.1.0",
    "engines": {
      "vessel": ">=0.33.0 <1.0.0"
    },
    "description": "Usage, logs and model leaderboard",
    "side": "both",
    "entry": "src/index.ts",
    "ui": {
      "dir": "web"
    },
    "activationEvents": [
      "onPage:usage",
      "onPage:logs",
      "onCommand:summary"
    ],
    "contributes": {
      "i18n": {
        "en": {
          "nav.group": "Usage",
          "nav.usage": "Usage",
          "nav.logs": "Logs"
        },
        "zh-CN": {
          "nav.group": "用量",
          "nav.usage": "用量",
          "nav.logs": "请求日志"
        }
      },
      "navGroups": [
        {
          "id": "plugin:usage",
          "title": "Usage",
          "titleKey": "nav.group",
          "order": 40
        }
      ],
      "pages": [
        {
          "id": "usage",
          "title": "Usage",
          "titleKey": "nav.usage",
          "nav": "plugin:usage",
          "icon": "observe",
          "order": 10,
          "entry": "usage.html"
        },
        {
          "id": "logs",
          "title": "Logs",
          "titleKey": "nav.logs",
          "nav": "plugin:usage",
          "icon": "runs",
          "order": 11,
          "entry": "logs.html"
        }
      ],
      "commands": [
        {
          "name": "summary",
          "title": "Usage summary"
        }
      ],
      "settings": {
        "prices": {
          "type": "object",
          "description": "USD per 1M tokens, keyed by model id"
        }
      },
      "rpc": [
        {
          "name": "summary",
          "description": "Aggregated usage"
        },
        {
          "name": "logs",
          "description": "Paginated request logs"
        },
        {
          "name": "leaderboard",
          "description": "Usage by model"
        }
      ],
      "events": [
        "llm.response",
        "llm.request",
        "run.failed"
      ]
    },
    "permissions": {
      "fs": [
        "data-dir"
      ],
      "net": [],
      "process": false,
      "secrets": false,
      "events": [
        "llm.response",
        "llm.request",
        "run.failed"
      ]
    },
    "dependencies": {
      "plugins": [],
      "ordering": {
        "after": [],
        "before": []
      }
    }
  }
}
