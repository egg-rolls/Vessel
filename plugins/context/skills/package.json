{
  "name": "@vessel-agent/plugin-skills",
  "version": "0.56.1",
  "description": "Managed skill library: scan / index / trust-gated load + library UI",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/egg-rolls/Vessel.git",
    "directory": "plugins/context/skills"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vessel-agent/basic-tools": "workspace:*",
    "@vessel-agent/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "vessel": {
    "id": "skills",
    "name": "Skills",
    "version": "0.1.0",
    "engines": {
      "vessel": ">=0.56.0 <1.0.0"
    },
    "description": "Managed skill library: scan / index / trust-gated load + library UI",
    "side": "both",
    "contributes": {
      "rpc": [
        {
          "name": "list",
          "description": "Skill index page (metadata only)",
          "permission": "read"
        },
        {
          "name": "get",
          "description": "Skill detail: entry + content + trust (human view)",
          "permission": "read"
        },
        {
          "name": "search",
          "description": "Substring search over name/description/tags/id",
          "permission": "read"
        },
        {
          "name": "loads",
          "description": "Per-session skill load records",
          "permission": "read"
        },
        {
          "name": "rescan",
          "description": "Rebuild the index from all enabled roots",
          "permission": "write"
        },
        {
          "name": "trust_set",
          "description": "Pin current hash (trust) or revoke trust for a skill",
          "permission": "write"
        }
      ],
      "settings": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch; false = install registers nothing"
        },
        "sources": {
          "type": "object",
          "default": {
            "project": true,
            "user": true,
            "library": true
          },
          "description": "Which skill roots to scan (project / user / library)"
        },
        "watch": {
          "type": "boolean",
          "default": true,
          "description": "Watch skill roots and rebuild the index (300ms debounce)"
        },
        "trust_default": {
          "type": "string",
          "enum": [
            "ask",
            "deny"
          ],
          "default": "ask",
          "description": "Policy for untrusted / changed skill content on load"
        },
        "max_load_bytes": {
          "type": "number",
          "default": 65536,
          "description": "Cap for skill content returned by load / get"
        },
        "allowed_roots": {
          "type": "array",
          "description": "Inherited from basic-tools when unset (assembly merge)"
        },
        "deny_paths": {
          "type": "array",
          "description": "Inherited from basic-tools; library root appended by assembly"
        }
      }
    },
    "permissions": {
      "fs": [
        "data-dir"
      ],
      "net": [],
      "process": false,
      "secrets": false,
      "events": [],
      "rpc": []
    }
  }
}
