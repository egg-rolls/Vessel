# Vessel deploy 环境变量示例（复制为 .env；★绝不提交真实密钥，.env 已被 .dockerignore/.gitignore 排除）
# 设计：docs/dev/design/docker-cd-design.md v2 §5.1。密钥只走 env，不落 YAML。

# 镜像版本（三镜像版本锁步；缺省 latest）。回滚：VESSEL_VERSION=<last-good> docker compose up -d
VESSEL_VERSION=latest
VESSEL_LOG_LEVEL=info

# node-1 显式 token —— ★双注入：同时给 gateway（代理注入 Authorization）与 node-1（token_env）。
# 生成：openssl rand -hex 32
NODE_1_TOKEN=

# hub token（hub.token_env=HUB_TOKEN；join 侧亦用）。生成：openssl rand -hex 32
HUB_TOKEN=

# node→hub 出站 join 配对码（hub.join_code_env=HUB_JOIN_CODE）。非回环 join 必须配对码。
# 由 hub 侧 `vessel hub join-code` 签发，或自定义强随机串后两侧一致。
HUB_JOIN_CODE=

# provider keys（node 服务 provider.api_key_env 引用；按需填）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 说明：NODE_EXTRA_CA_CERTS=/certs/ca.crt 由各 compose 服务直接注入（互信内部 CA），不在此设置。
# 不设 VESSEL_DATA_DIR（CMD 已 --data-dir /data）；不设 VESSEL_USER_CONFIG（默认 ~/.vessel/config.yaml 挂载即生效）。